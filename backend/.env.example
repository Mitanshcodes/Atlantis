NESSIE_API_KEY=
# Confirm the host with your event before enabling live writes.
NESSIE_BASE_URL=https://prod-api.nessieisreal.com
NESSIE_LIVE=false
# Enable each resource only after the live probe confirms it can be read back.
NESSIE_LOANS_VERIFIED=false
NESSIE_BILLS_VERIFIED=false
# Current production behavior: transaction resources do not update account.balance.
NESSIE_TRANSACTION_RECORDS_ONLY=true
ATLANTIS_DB=atlantis.sqlite3
# p1 = the real game engine (default); development = P2's fixed test economy.
ATLANTIS_ENGINE=p1
GEMINI_API_KEY=
# Choose an available generateContent model from your Google AI Studio account.
GEMINI_MODEL=
# Chelo's note on each season report. Optional; without it a hand-written line is used.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
