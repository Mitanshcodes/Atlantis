NESSIE_TRANSACTION_RECORDS_ONLY=true
ATLANTIS_DB=atlantis.sqlite3
ATLANTIS_ENGINE=development
GEMINI_API_KEY=
# Choose an available generateContent model from your Google AI Studio account.
